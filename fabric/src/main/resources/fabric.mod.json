{
  "schemaVersion": 1,
  "id": "arenas_ld",
  "version": "${version}",

  "name": "Arenas_LD",
  "description": "Instanced PvE content built from your own builds: multi-room dungeons, endless wave arenas and raid bosses, with lobbies, parties, difficulty tiers, instances and leaderboards.",
  "authors": ["LeDok"],
  "contact": {
    "homepage": "https://github.com/ledokua/Arenas_LD",
    "sources": "https://github.com/ledokua/Arenas_LD",
    "issues": "https://github.com/ledokua/Arenas_LD/issues",
    "discord": "ledokua"
  },

  "license": "MIT",
  "icon": "assets/arenas_ld/icon.png",

  "environment": "*",
  "entrypoints": {
    "client": [
      "net.ledok.arenas_ld.fabric.ArenasLdClientFabric"
    ],
    "main": [
      "net.ledok.arenas_ld.fabric.ArenasLdModFabric"
    ],
    "fabric-gametest": [
      "net.ledok.arenas_ld.gametest.ArenasLdGametests"
    ]
  },

  "mixins": [
    "arenas_ld.mixins.json",
    "arenas_ld_fabric.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "busylib": "*",
    "vectorlib": ">=0.2.6"
  },
  "suggests": {
    "economy_ld": "*"
  }
}
