{
  "schemaVersion": 1,
  "id": "arenas_ld",
  "version": "${version}",

  "name": "Arenas_LD",
  "description": "Mod that adds admin utilities for creating dungeons/raids",
  "authors": [],
  "contact": {},

  "license": "MIT",
  "icon": "assets/arenas_ld/icon.png",

  "environment": "*",
  "entrypoints": {
    "client": [
      "net.ledok.arenas_ld.fabric.ArenasLdClientFabric"
    ],
    "main": [
      "net.ledok.arenas_ld.fabric.ArenasLdModFabric"
    ],
    "fabric-gametest": [
      "net.ledok.arenas_ld.gametest.ArenasLdGametests"
    ]
  },

  "mixins": [
    "arenas_ld.mixins.json",
    "arenas_ld_fabric.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "busylib": "*",
    "owo": ">=0.12.15"
  },
  "suggests": {
    "economy_ld": "*"
  }
}
